                  "    });",
                  "} catch (e) {",
                  "    console.error(\"Failed to parse confirm OTP response:\", e);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Reset Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "{{tokenBearer}} {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{newPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "**Purpose**: Reset user password to a new value.\n\n**Note**: The controller route is defined with `@Get('/reset-password')` but expects a JSON request body `resetPasswordDTO` with `@Body() dto: resetPasswordDTO`.\n\n**Auth/Role**: Authenticated via `@authenticationGuard()`. Requires `authorization: {{tokenBearer}} {{accessToken}}`.\n\n**Validation Requirements** (resetPasswordDTO):\n- `password`: string\n\n**Preconditions**: Valid authenticated user session (`accessToken`). Note: see README regarding `req.user` in `tokenVerificationGuard`.\n\n**Expected Status**: 200 OK."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "try {",
                  "    var res = pm.response.json();",
                  "    pm.test(\"Password reset message\", function () {",
                  "        pm.expect(res.message).to.eql(\"password updated\");",
                  "    });",
                  "} catch (e) {",
                  "    console.error(\"Failed to parse reset password response:\", e);",
                  "}"
                ]
              }
            }
          ]
        },
