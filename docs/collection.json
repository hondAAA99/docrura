        {
          "name": "14. Logout All Sessions",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "{{tokenBearer}} {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout?flag=all",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"],
              "query": [
                {
                  "key": "flag",
                  "value": "all",
                  "description": "When flag=all, updates credentials date on user to invalidate all active tokens"
                }
              ]
            },
            "description": "**Purpose**: Invalidate all sessions and tokens for the user by updating `credentials` timestamp.\n\n**Auth/Role**: Authenticated via `@authenticationGuard()`. Requires `authorization: {{tokenBearer}} {{accessToken}}`.\n\n**Query Parameters**:\n- `flag=all`\n\n**Preconditions**: Active authenticated session.\n\n**Expected Status**: 200 OK.\n\n**Cleanup**: Unsets `accessToken` and `refreshToken` from the environment."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.environment.unset(\"accessToken\");",
                  "pm.environment.unset(\"refreshToken\");"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

